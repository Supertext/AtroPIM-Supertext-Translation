{
  "name": "supertext/atropim-supertext-translation",
  "description": "Supertext AI translation for AtroPIM and AtroCore: translate products and other records into your other languages.",
  "type": "library",
  "license": "MIT",
  "keywords": ["atrocore", "atropim", "pim", "translation", "supertext", "ai"],
  "homepage": "https://github.com/Supertext/AtroPIM-Supertext-Translation",
  "authors": [
    {"name": "Supertext AG", "homepage": "https://www.supertext.com"}
  ],
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "atrocore/core": "^2.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "SupertextTranslation\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SupertextTranslation\\Tests\\": "tests/"
    }
  },
  "extra": {
    "atroId": "SupertextTranslation",
    "name": {
      "default": "Supertext Translation",
      "de_DE": "Supertext-Übersetzung"
    },
    "description": {
      "default": "Translate products and other records into your other languages with Supertext AI.",
      "de_DE": "Übersetzt Produkte und andere Datensätze mit Supertext AI in Ihre anderen Sprachen."
    },
    "tags": ["translation", "ai", "content"]
  },
  "config": {
    "sort-packages": true
  }
}
