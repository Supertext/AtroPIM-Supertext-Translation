# Supertext Translation for AtroPIM: demo variables.
# On Railway these are service variables; locally pass them with `docker run --env-file`.
# Never commit real values.

# --- Supertext ---------------------------------------------------------------
# No Supertext account yet? Create one at supertext.com:
#   https://www.supertext.com/person/en/account/signin
# Generate your API key at supertext.com → Integrations → API (requires the Admin role):
#   https://www.supertext.com/en/integrations/api
# The demo's Supertext connection has no key of its own and uses this one.
SUPERTEXT_API_KEY=
# Only for tests against a stand-in API (leave empty for the live API).
SUPERTEXT_API_URL=

# --- Demo accounts (created on every start if missing, never changed) ----------
# Log in with the e-mail address. Passwords: at least 8 characters with an upper-case
# letter, a digit and a special character (AtroCore's rule).
# Administrator; replaces AtroCore's installation screen.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Role "Product editor (Supertext demo)": edits and translates products in every language.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# --- Database (MySQL 8.4) ----------------------------------------------------
# Railway: mysql://root:${{MySQL-8.MYSQL_ROOT_PASSWORD}}@mysql8.railway.internal:3306/railway
MYSQL_URL=
# The demo's own database on that server (created if needed; AtroCore's installer empties it,
# so never use a shared database here).
ATROPIM_DB_NAME=atropim

# Public address, if it isn't Railway's RAILWAY_PUBLIC_DOMAIN.
DEMO_SITE_URL=
